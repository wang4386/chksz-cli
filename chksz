# ---------------- 依赖安装 ----------------
detect_pm() {
  if command -v apt-get >/dev/null 2>&1; then echo "apt-get"
  elif command -v dnf >/dev/null 2>&1; then echo "dnf"
  elif command -v yum >/dev/null 2>&1; then echo "yum"
  elif command -v apk >/dev/null 2>&1; then echo "apk"
  elif command -v pacman >/dev/null 2>&1; then echo "pacman"
  elif command -v pkg >/dev/null 2>&1; then echo "pkg"      # Termux
  elif command -v brew >/dev/null 2>&1; then echo "brew"
  else echo ""
  fi
}

# pkg_install <包名...> : 用系统包管理器安装软件包, 自动处理 sudo
pkg_install() {
  local pm sudo_cmd=""
  pm="$(detect_pm)"
  [ -z "$pm" ] && { err "未识别到包管理器, 请手动安装: $*"; return 1; }
  [ "$(id -u)" != "0" ] && command -v sudo >/dev/null 2>&1 && sudo_cmd="sudo"
  info "使用 $pm 安装: $*"
  case "$pm" in
    apt-get)
      [ -z "${_APT_UPDATED:-}" ] && { $sudo_cmd apt-get update -qq; _APT_UPDATED=1; }
      $sudo_cmd apt-get install -y "$@" ;;
    dnf|yum) $sudo_cmd "$pm" install -y "$@" ;;
    apk)     $sudo_cmd apk add "$@" ;;
    pacman)  $sudo_cmd pacman -Sy --noconfirm "$@" ;;
    pkg)     pkg install -y "$@" ;;
    brew)    brew install "$@" ;;
  esac
}

# pkg_name <通用名> : 返回当前发行版下的实际包名
pkg_name() {
  local pm
  pm="$(detect_pm)"
  case "$1" in
    python3)
      case "$pm" in pacman) echo "python" ;; *) echo "python3" ;; esac ;;
    python3-pip)
      case "$pm" in
        apk) echo "py3-pip" ;;
        pacman) echo "python-pip" ;;
        pkg|brew) echo "python3" ;;  # Termux/brew 的 python 自带 pip
        *) echo "python3-pip" ;;
      esac ;;
    *) echo "$1" ;;
  esac
}

install_deps() {
  local missing=() c
  for c in curl jq; do
    command -v "$c" >/dev/null 2>&1 || missing+=("$c")
  done
  if [ ${#missing[@]} = 0 ]; then
    ok "必需依赖已齐全: curl, jq"
  elif pkg_install "${missing[@]}"; then
    ok "依赖安装完成"
  else
    err "依赖安装失败"; return 1
  fi

  # 可选: ffmpeg (封面/元数据嵌入)
  if ! command -v ffmpeg >/dev/null 2>&1; then
    local yn
    read -rp "是否安装 ffmpeg (用于封面/元数据嵌入)? [y/N]: " yn < /dev/tty
    if [[ "$yn" =~ ^[yY]$ ]] && ! pkg_install ffmpeg; then
      warn "ffmpeg 安装失败, 可手动安装"
    fi
  else
    ok "ffmpeg 已安装"
  fi

  # 可选: python3 + mutagen (标准歌词帧 USLT/LYRICS 嵌入, 原版 CDown 同款)
  if command -v python3 >/dev/null 2>&1 && python3 -c "import mutagen" 2>/dev/null; then
    ok "mutagen 已安装"
  else
    local yn2
    read -rp "是否安装 mutagen (把歌词/封面嵌入歌曲文件, 播放器免刮削)? [y/N]: " yn2 < /dev/tty
    if [[ "$yn2" =~ ^[yY]$ ]]; then
      # 先确保 python3 与 pip 存在, 缺失则自动安装
      if ! command -v python3 >/dev/null 2>&1; then
        pkg_install "$(pkg_name python3)" || { err "python3 安装失败"; return 1; }
      fi
      if ! python3 -m pip --version >/dev/null 2>&1; then
        info "pip 缺失, 正在自动安装..."
        pkg_install "$(pkg_name python3-pip)" || { err "pip 安装失败"; return 1; }
      fi
      if python3 -m pip install --user -q mutagen 2>/dev/null || \
         python3 -m pip install -q --break-system-packages mutagen 2>/dev/null; then
        ok "mutagen 已安装"
      else
        warn "mutagen 安装失败, 可手动执行: python3 -m pip install mutagen"
      fi
    fi
  fi
}

# ---------------- 安装 chksz 快捷命令 ----------------
install_shortcut() {
  local target="$HOME/.local/bin/chksz"
  mkdir -p "$HOME/.local/bin"
  cp -f "$SELF" "$target"
  chmod +x "$target"
  ok "已安装到 $target"
  if ! echo "$PATH" | grep -q "$HOME/.local/bin"; then
    {
      echo ''
      echo '# chksz 快捷命令'
      echo 'export PATH="$HOME/.local/bin:$PATH"'
    } >> "$HOME/.bashrc"
    export PATH="$HOME/.local/bin:$PATH"
    warn "已将 ~/.local/bin 加入 PATH (写入 ~/.bashrc), 重新登录或执行 source ~/.bashrc 生效"
  fi
  if command -v chksz >/dev/null 2>&1; then
    ok "现在可以直接输入 chksz 唤出菜单"
  else
    info "本次终端可执行: export PATH=\"\$HOME/.local/bin:\$PATH\""
  fi
}

# ---------------- 卸载 ----------------
# 安全卸载: 逐项确认, 危险操作默认否; 歌曲文件默认保留
uninstall() {
  local yn
  hr
  echo "卸载 chksz (安全模式, 每一步都会询问)"
  echo "将执行:"
  echo "  1. 删除快捷命令: $HOME/.local/bin/chksz"
  echo "  2. 删除配置目录: $CONFIG_DIR (含 API Key)"
  echo "  3. 清理 ~/.bashrc 中的 PATH 设置"
  echo "  4. 逐个询问是否移除依赖 (curl/jq/ffmpeg/mutagen, 默认不移除)"
  echo "  5. 询问是否保留已下载歌曲 (默认保留)"
  read -rp "确认卸载? [y/N]: " yn < /dev/tty
  [[ "$yn" =~ ^[yY]$ ]] || { echo "已取消"; return 0; }

  # 1. 快捷命令 (脚本本身即使正在运行, 删除文件也是安全的)
  if [ -f "$HOME/.local/bin/chksz" ]; then
    rm -f "$HOME/.local/bin/chksz" && ok "已删除快捷命令"
  else
    info "未发现快捷命令, 跳过"
  fi

  # 2. 配置目录 (含 API Key, 必须清除)
  if [ -d "$CONFIG_DIR" ]; then
    rm -rf "$CONFIG_DIR" && ok "已删除配置目录 (API Key 已清除)"
  fi

  # 3. 清理 ~/.bashrc 中安装时写入的 PATH 设置 (只删我们自己加的那两行)
  if [ -f "$HOME/.bashrc" ] && grep -q '# chksz 快捷命令' "$HOME/.bashrc"; then
    awk '
      /^# chksz 快捷命令$/ { skip=1; next }
      skip==1 && /^export PATH="\$HOME\/.local\/bin:\$PATH"$/ { skip=0; next }
      { skip=0; print }
    ' "$HOME/.bashrc" > "$HOME/.bashrc.tmp" \
      && mv -f "$HOME/.bashrc.tmp" "$HOME/.bashrc" \
      && ok "已清理 ~/.bashrc (重新登录后 PATH 恢复)"
  fi

  # 4. 依赖: 逐个询问, 默认不移除
  local pm sudo_cmd=""
  pm="$(detect_pm)"
  [ "$(id -u)" != "0" ] && command -v sudo >/dev/null 2>&1 && sudo_cmd="sudo"
  local item cmd pkg
  for item in "curl:curl" "jq:jq" "ffmpeg:ffmpeg"; do
    cmd="${item%%:*}"; pkg="$(pkg_name "$cmd")"
    if command -v "$cmd" >/dev/null 2>&1; then
      read -rp "是否移除 $cmd? (如被其他程序使用请选否) [y/N]: " yn < /dev/tty
      if [[ "$yn" =~ ^[yY]$ ]]; then
        case "$pm" in
          apt-get) $sudo_cmd apt-get remove -y "$pkg" ;;
          dnf|yum) $sudo_cmd "$pm" remove -y "$pkg" ;;
          apk)     $sudo_cmd apk del "$pkg" ;;
          pacman)  $sudo_cmd pacman -Rs --noconfirm "$pkg" ;;
          pkg)     pkg uninstall -y "$pkg" ;;
          brew)    brew uninstall "$pkg" ;;
          *) warn "未识别包管理器, 请手动移除 $pkg"; continue ;;
        esac && ok "已移除 $cmd" || warn "$cmd 移除失败"
      fi
    fi
  done
  if command -v python3 >/dev/null 2>&1 && python3 -c "import mutagen" 2>/dev/null; then
    read -rp "是否移除 mutagen? [y/N]: " yn < /dev/tty
    if [[ "$yn" =~ ^[yY]$ ]]; then
      if python3 -m pip uninstall -y -q mutagen 2>/dev/null || \
         python3 -m pip uninstall -y -q --break-system-packages mutagen 2>/dev/null; then
        ok "已移除 mutagen"
      else
        warn "mutagen 移除失败"
      fi
    fi
  fi

  # 5. 已下载歌曲: 默认保留
  if [ -d "$SAVE_DIR" ]; then
    local yn3
    read -rp "是否保留已下载的歌曲文件? ($SAVE_DIR) [Y/n]: " yn3 < /dev/tty
    if [[ "$yn3" =~ ^[nN]$ ]]; then
      case "$SAVE_DIR" in
        ""|"/"|"$HOME")
          err "拒绝删除关键目录 ($SAVE_DIR), 请手动处理" ;;
        *)
          rm -rf "$SAVE_DIR" && ok "已删除歌曲文件" ;;
      esac
    else
      ok "已保留歌曲文件: $SAVE_DIR"
    fi
  else
    info "下载目录不存在, 跳过"
  fi

  echo
  ok "卸载完成"
}

