# ---------------- 检查更新 / 更新脚本 ----------------
# 更新源 UPDATE_URL 见脚本头部, 可用 CHKSZ_RAW_URL 环境变量覆盖。
# 不做启动时自动检查: 只在用户显式运行 check-update / update (或菜单 10) 时联网,
# 日常命令不因检查更新变慢或失败。

extract_version() {
  # $1=脚本文件 -> 输出其中的 VERSION 值, 找不到则为空
  sed -n 's/^VERSION="\([^"]*\)".*/\1/p' "$1" 2>/dev/null | head -n 1
}

version_newer() {
  # $1 是否比 $2 新 (x.y.z 逐段数字比较), 是返回 0
  local -a a=() b=()
  local i av bv
  IFS=. read -ra a <<< "$1"
  IFS=. read -ra b <<< "$2"
  for ((i = 0; i < ${#a[@]} || i < ${#b[@]}; i++)); do
    av="${a[i]:-0}"; bv="${b[i]:-0}"
    av="${av//[^0-9]/}"; bv="${bv//[^0-9]/}"
    [ -z "$av" ] && av=0
    [ -z "$bv" ] && bv=0
    if ((10#$av > 10#$bv)); then return 0; fi
    if ((10#$av < 10#$bv)); then return 1; fi
  done
  return 1
}

# check_update : 结果写全局 REMOTE_VERSION / UPDATE_AVAILABLE；
# 检查本身成功返回 0, 拉取/解析失败返回 1。
REMOTE_VERSION=""
UPDATE_AVAILABLE=0
check_update() {
  REMOTE_VERSION=""
  UPDATE_AVAILABLE=0
  info "检查更新 (源: $UPDATE_URL)"
  local tmp=""
  tmp="$(mktemp)" || return 1
  if ! curl -fsSL --max-time 30 "$UPDATE_URL" -o "$tmp"; then
    rm -f "$tmp"
    err "无法获取远程脚本, 请检查网络或更新源地址"
    return 1
  fi
  REMOTE_VERSION="$(extract_version "$tmp")"
  rm -f "$tmp"
  if [ -z "$REMOTE_VERSION" ]; then
    err "远程脚本中未找到版本号, 无法判断更新"
    return 1
  fi
  printf "当前版本: v%s\n最新版本: v%s\n" "$VERSION" "$REMOTE_VERSION"
  if version_newer "$REMOTE_VERSION" "$VERSION"; then
    UPDATE_AVAILABLE=1
    ok "有新版本可用: v$VERSION -> v$REMOTE_VERSION, 运行 chksz update 更新"
  elif [ "$REMOTE_VERSION" = "$VERSION" ]; then
    ok "已是最新版本"
  else
    info "本地版本高于远程发布版本, 无需更新 (本地可能是未发布版本)"
  fi
  return 0
}

# update_self [--force]
# 安全顺序: 下载到同目录临时文件 -> 校验 (非空/shebang/版本号/bash -n) ->
# 版本比较 (默认不降级、不重装同版本, --force 才允许) -> 备份旧版到
# $SELF.bak -> chmod +x 后 mv 原子替换 -> 跑新版 version 复核, 失败自动回滚。
# 用 mv 换新文件 (新 inode) 而不是覆盖写: 正在运行的旧进程仍持有旧
# inode, 不会读到写一半的脚本；新版本从下次运行 chksz 起生效。
UPDATE_PERFORMED=0
update_self() {
  UPDATE_PERFORMED=0
  local force=0
  case "${1:-}" in
    "" ) ;;
    --force|-f) force=1 ;;
    *) err "未知选项: $1 (用法: chksz update [--force])"; return 1 ;;
  esac
  if [ ! -f "$SELF" ]; then
    err "当前不是以文件方式运行 chksz, 无法自更新"
    err "请先用一键安装装好脚本, 再运行 chksz update"
    return 1
  fi
  local dir=""
  dir="$(dirname "$SELF")"
  if [ ! -w "$SELF" ] || [ ! -w "$dir" ]; then
    err "当前脚本不可写: $SELF"
    err "可以用一键安装命令更新: curl -fsSL https://raw.githubusercontent.com/wang4386/chksz-cli/main/install.sh | bash"
    return 1
  fi
  info "下载最新脚本 (源: $UPDATE_URL)"
  local tmp=""
  tmp="$(mktemp "$dir/.chksz-update.XXXXXX")" || { err "无法在 $dir 创建临时文件"; return 1; }
  if ! curl -fsSL --max-time 60 "$UPDATE_URL" -o "$tmp"; then
    rm -f "$tmp"
    err "下载失败, 未更新 (网络或更新源问题)"
    return 1
  fi
  # --- 校验远程内容, 任一项不过都放弃, 当前脚本原样不动 ---
  if [ ! -s "$tmp" ]; then
    rm -f "$tmp"; err "远程脚本为空, 已放弃更新"; return 1
  fi
  if ! head -n 1 "$tmp" | grep -q '^#!.*bash'; then
    rm -f "$tmp"; err "远程内容不像是 bash 脚本, 已放弃更新"; return 1
  fi
  local remote_ver=""
  remote_ver="$(extract_version "$tmp")"
  if [ -z "$remote_ver" ]; then
    rm -f "$tmp"; err "远程脚本中未找到版本号, 已放弃更新"; return 1
  fi
  if ! bash -n "$tmp" 2>/dev/null; then
    rm -f "$tmp"; err "远程脚本语法检查未通过, 已放弃更新"; return 1
  fi
  # --- 版本比较 ---
  if [ "$remote_ver" = "$VERSION" ] && [ "$force" != 1 ]; then
    rm -f "$tmp"
    ok "已是最新版本 v$VERSION, 无需更新 (强制重装: chksz update --force)"
    return 0
  fi
  if version_newer "$VERSION" "$remote_ver" && [ "$force" != 1 ]; then
    rm -f "$tmp"
    warn "远程版本 v$remote_ver 低于本地 v$VERSION, 已拒绝降级 (确需降级: chksz update --force)"
    return 0
  fi
  # --- 备份 + 原子替换 ---
  if ! cp -f "$SELF" "$SELF.bak"; then
    rm -f "$tmp"
    err "备份旧版本失败 ($SELF.bak), 已放弃更新"
    return 1
  fi
  chmod +x "$tmp"
  if ! mv -f "$tmp" "$SELF"; then
    rm -f "$tmp"
    err "替换脚本失败, 旧版本未动 (备份在 $SELF.bak)"
    return 1
  fi
  # --- 复核新版本, 不通过就用备份回滚 ---
  local new_out=""
  new_out="$("$SELF" version 2>/dev/null)"
  if [ "$new_out" != "chksz v$remote_ver" ]; then
    err "新版本复核失败 (期望 'chksz v$remote_ver', 实际 '$new_out'), 正在回滚"
    if mv -f "$SELF.bak" "$SELF"; then
      err "已回滚到旧版本 v$VERSION"
    else
      err "回滚也失败了! 旧版本备份在 $SELF.bak, 请手动恢复"
    fi
    return 1
  fi
  UPDATE_PERFORMED=1
  ok "已更新: v$VERSION -> v$remote_ver"
  info "旧版本备份在: $SELF.bak (回滚: cp $SELF.bak $SELF)"
  info "新版本从下次运行 chksz 起生效；若在菜单中更新, 请退出后重新进入"
  return 0
}

# 菜单里的更新: 先检查, 有新版才询问, 更新成功后提示重进菜单
update_menu() {
  check_update || return 0
  if [ "$UPDATE_AVAILABLE" != 1 ]; then
    return 0
  fi
  local yn=""
  read -rp "发现新版本 v$REMOTE_VERSION, 是否现在更新? [y/N]: " yn < /dev/tty
  if [[ "$yn" =~ ^[yY]$ ]]; then
    if update_self && [ "$UPDATE_PERFORMED" = 1 ]; then
      ok "更新完成, 请退出并重新运行 chksz 使用新版本"
    fi
  else
    info "暂不更新, 需要时运行: chksz update"
  fi
}

# ---------------- 卸载 ----------------
# 安全卸载: 逐项确认, 危险操作默认否; 歌曲文件默认保留
uninstall() {
  local yn
  hr
  echo "卸载 chksz (安全模式, 每一步都会询问)"
  echo "将执行:"
  echo "  1. 删除快捷命令: $HOME/.local/bin/chksz"
  echo "  2. 删除配置目录: $CONFIG_DIR (含 API Key 与下载记录)"
  echo "  3. 清理 ~/.bashrc 中的 PATH 设置"
  echo "  4. 逐个询问是否移除依赖 (curl/jq/ffmpeg/mutagen, 默认不移除)"
  echo "  5. 询问是否保留已下载歌曲 (默认保留)"
  read -rp "确认卸载? [y/N]: " yn < /dev/tty
  [[ "$yn" =~ ^[yY]$ ]] || { echo "已取消"; return 0; }

  # 1. 快捷命令 (脚本本身即使正在运行, 删除文件也是安全的)
  if [ -f "$HOME/.local/bin/chksz" ]; then
    rm -f "$HOME/.local/bin/chksz" && ok "已删除快捷命令"
  else
    info "未发现快捷命令, 跳过"
  fi

  # 2. 配置目录 (含 API Key, 必须清除)
  if [ -d "$CONFIG_DIR" ]; then
    rm -rf "$CONFIG_DIR" && ok "已删除配置目录 (API Key 已清除)"
  fi

  # 3. 清理 ~/.bashrc 中安装时写入的 PATH 设置 (只删我们自己加的那两行)
  if [ -f "$HOME/.bashrc" ] && grep -q '# chksz 快捷命令' "$HOME/.bashrc"; then
    awk '
      /^# chksz 快捷命令$/ { skip=1; next }
      skip==1 && /^export PATH="\$HOME\/.local\/bin:\$PATH"$/ { skip=0; next }
      { skip=0; print }
    ' "$HOME/.bashrc" > "$HOME/.bashrc.tmp" \
      && mv -f "$HOME/.bashrc.tmp" "$HOME/.bashrc" \
      && ok "已清理 ~/.bashrc (重新登录后 PATH 恢复)"
  fi

  # 4. 依赖: 逐个询问, 默认不移除
  local pm sudo_cmd=""
  pm="$(detect_pm)"
  [ "$(id -u)" != "0" ] && command -v sudo >/dev/null 2>&1 && sudo_cmd="sudo"
  local item cmd pkg
  for item in "curl:curl" "jq:jq" "ffmpeg:ffmpeg"; do
    cmd="${item%%:*}"; pkg="$(pkg_name "$cmd")"
    if command -v "$cmd" >/dev/null 2>&1; then
      read -rp "是否移除 $cmd? (如被其他程序使用请选否) [y/N]: " yn < /dev/tty
      if [[ "$yn" =~ ^[yY]$ ]]; then
        case "$pm" in
          apt-get) $sudo_cmd apt-get remove -y "$pkg" ;;
          dnf|yum) $sudo_cmd "$pm" remove -y "$pkg" ;;
          apk)     $sudo_cmd apk del "$pkg" ;;
          pacman)  $sudo_cmd pacman -Rs --noconfirm "$pkg" ;;
          pkg)     pkg uninstall -y "$pkg" ;;
          brew)    brew uninstall "$pkg" ;;
          *) warn "未识别包管理器, 请手动移除 $pkg"; continue ;;
        esac && ok "已移除 $cmd" || warn "$cmd 移除失败"
      fi
    fi
  done
  if command -v python3 >/dev/null 2>&1 && python3 -c "import mutagen" 2>/dev/null; then
    read -rp "是否移除 mutagen? [y/N]: " yn < /dev/tty
    if [[ "$yn" =~ ^[yY]$ ]]; then
      if python3 -m pip uninstall -y -q mutagen 2>/dev/null || \
         python3 -m pip uninstall -y -q --break-system-packages mutagen 2>/dev/null; then
        ok "已移除 mutagen"
      else
        warn "mutagen 移除失败"
      fi
    fi
  fi

  # 5. 已下载歌曲: 默认保留
  if [ -d "$SAVE_DIR" ]; then
    local yn3
    read -rp "是否保留已下载的歌曲文件? ($SAVE_DIR) [Y/n]: " yn3 < /dev/tty
    if [[ "$yn3" =~ ^[nN]$ ]]; then
      case "$SAVE_DIR" in
        ""|"/"|"$HOME")
          err "拒绝删除关键目录 ($SAVE_DIR), 请手动处理" ;;
        *)
          rm -rf "$SAVE_DIR" && ok "已删除歌曲文件" ;;
      esac
    else
      ok "已保留歌曲文件: $SAVE_DIR"
    fi
  else
    info "下载目录不存在, 跳过"
  fi

  echo
  ok "卸载完成"
}

