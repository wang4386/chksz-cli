#!/usr/bin/env bash
#
# chksz — ChKSz API 交互式音乐下载脚本 (网易云音乐)
#
# 根据 https://github.com/ChKSz/CDown 重构的纯 Shell 交互式版本，
# 适配新版 API https://api.chksz.com (旧域名 api.chksz.top 已弃用，
# 新版全部 163_* 接口均需 apikey 参数)。
#
# 功能:
#   1) 交互式搜索歌曲并下载
#   2) 歌单 ID/链接解析并批量下载
#   3) 下载位置 / 首选音质 / API Key 等设置，持久化保存
#   4) 依赖一键安装 (curl / jq / ffmpeg 可选)
#   5) 音质按 jymaster > hires > lossless > exhigh > standard 依次回退
#   6) `chksz install` 安装 chksz 快捷命令
#   7) 下载记录 (history.tsv)，可检测已下载歌曲的歌词嵌入状态并可选修复
#   8) 下载时若目录中已有同名文件, 先询问覆盖/创建副本/跳过 (无 TTY 默认副本)
#   9) 检查更新与自更新: chksz check-update 比对远程版本, chksz update 安全更新
#
# 用法: chksz [search "关键词"|playlist <ID或链接>|song <歌曲ID>|key <apikey>|...]
#       直接运行 chksz 进入交互菜单。

set -u

VERSION="1.3.0"
API_BASE="https://api.chksz.com/api"
# 更新源: 与 install.sh 的 CHKSZ_RAW_URL 同一约定, 可用环境变量覆盖 (镜像/自建源)
UPDATE_URL="${CHKSZ_RAW_URL:-https://raw.githubusercontent.com/wang4386/chksz-cli/main/chksz}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/chksz"
CONFIG_FILE="$CONFIG_DIR/config"
HISTORY_FILE="$CONFIG_DIR/history.tsv"

# 音质等级: 从高到低
LEVELS=(jymaster hires lossless exhigh standard)
declare -A LEVEL_NAME=(
  [jymaster]="超清母带"
  [hires]="Hi-Res"
  [lossless]="无损"
  [exhigh]="极高"
  [standard]="标准"
)
declare -A LEVEL_EXT=(
  [jymaster]="flac"
  [hires]="flac"
  [lossless]="flac"
  [exhigh]="mp3"
  [standard]="mp3"
)

SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "$0")"

# ---------------- 基础输出 ----------------
if [ -t 1 ]; then
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'
  C_BLUE=$'\033[34m'; C_CYAN=$'\033[36m'; C_BOLD=$'\033[1m'; C_RESET=$'\033[0m'
else
  C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_CYAN=""; C_BOLD=""; C_RESET=""
fi

info()  { printf "%s[*]%s %s\n" "$C_BLUE" "$C_RESET" "$*"; }
ok()    { printf "%s[✓]%s %s\n" "$C_GREEN" "$C_RESET" "$*"; }
warn()  { printf "%s[!]%s %s\n" "$C_YELLOW" "$C_RESET" "$*"; }
err()   { printf "%s[✗]%s %s\n" "$C_RED" "$C_RESET" "$*" >&2; }
die()   { err "$*"; exit 1; }
hr()    { printf '%*s\n' "${COLUMNS:-60}" '' | tr ' ' '-'; }

pause() { read -rp "按回车继续..." _ < /dev/tty; }

# ---------------- 配置持久化 ----------------
# 默认值
APIKEY=""
SAVE_DIR="$HOME/Music/chksz"
QUALITY="jymaster"
SAVE_LRC=1
EMBED_META=1

load_config() {
  if [ -f "$CONFIG_FILE" ]; then
    # 仅读取白名单键，避免执行任意内容
    while IFS='=' read -r k v; do
      case "$k" in
        APIKEY|SAVE_DIR|QUALITY|SAVE_LRC|EMBED_META)
          # 去掉首尾引号
          v="${v%\"}"; v="${v#\"}"
          printf -v "$k" '%s' "$v"
          ;;
      esac
    done < "$CONFIG_FILE"
  fi
  [ -z "$QUALITY" ] && QUALITY="jymaster"
  [ -z "$SAVE_DIR" ] && SAVE_DIR="$HOME/Music/chksz"
}

save_config() {
  mkdir -p "$CONFIG_DIR"
  {
    printf 'APIKEY="%s"\n' "$APIKEY"
    printf 'SAVE_DIR="%s"\n' "$SAVE_DIR"
    printf 'QUALITY="%s"\n' "$QUALITY"
    printf 'SAVE_LRC="%s"\n' "$SAVE_LRC"
    printf 'EMBED_META="%s"\n' "$EMBED_META"
  } > "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
  ok "配置已保存到 $CONFIG_FILE"
}

show_config() {
  hr
  printf "API Key     : %s\n" "$([ -n "$APIKEY" ] && echo "${APIKEY:0:6}******(已设置)" || echo "${C_RED}未设置${C_RESET}")"
  printf "下载目录    : %s\n" "$SAVE_DIR"
  printf "首选音质    : %s (%s)\n" "$QUALITY" "${LEVEL_NAME[$QUALITY]:-?}"
  printf "回退顺序    : %s\n" "$(fallback_levels | tr '\n' ' ')"
  printf "保存歌词    : %s\n" "$([ "$SAVE_LRC" = 1 ] && echo "是" || echo "否")"
  printf "元数据嵌入  : %s\n" "$([ "$EMBED_META" = 1 ] && echo "是 (封面/歌词/标签, 需 mutagen 或 ffmpeg)" || echo "否")"
  hr
}

# 从首选音质开始的回退顺序 (每行一个)
fallback_levels() {
  local start=0 i
  for i in "${!LEVELS[@]}"; do
    [ "${LEVELS[$i]}" = "$QUALITY" ] && { start=$i; break; }
  done
  for ((i = start; i < ${#LEVELS[@]}; i++)); do
    echo "${LEVELS[$i]}"
  done
}

require_apikey() {
  if [ -z "$APIKEY" ]; then
    err "尚未设置 API Key。请先在菜单 4) 设置，或执行: chksz key <你的apikey>"
    err "获取地址: https://api.chksz.com (登录后查看个人密钥)"
    return 1
  fi
}

# ---------------- API 调用层 ----------------
# api_get <endpoint> ["k=v" ...]  -> 输出响应 body
api_get() {
  local endpoint="$1"; shift
  local args=(--data-urlencode "apikey=$APIKEY")
  local p
  for p in "$@"; do
    args+=(--data-urlencode "$p")
  done
  curl -sS --max-time 30 --retry 2 --retry-delay 1 -G \
    "$API_BASE/$endpoint" "${args[@]}"
}

# 检查响应: $1=body ; 401 时提示 key 问题并返回 1
api_code() { jq -r '.code // 0' <<<"$1" 2>/dev/null || echo 0; }

check_api_resp() {
  local body="$1" action="$2"
  local code
  code=$(api_code "$body")
  if [ "$code" = "401" ]; then
    err "API Key 无效或缺失 ($(jq -r '.msg // ""' <<<"$body"))"
    err "请检查设置中的 API Key: chksz key <apikey>"
    return 1
  fi
  if [ "$code" != "200" ]; then
    err "${action}失败: code=$code msg=$(jq -r '.msg // ""' <<<"$body")"
    return 1
  fi
  return 0
}

# ---------------- 工具函数 ----------------
sanitize() {
  # 文件名清洗: 非法字符 -> 下划线, 限长
  local s="$1"
  s="$(printf '%s' "$s" | tr '/\\:*?"<>|' '_' | sed 's/^[ .]*//;s/[ .]*$//')"
  [ ${#s} -gt 100 ] && s="${s:0:100}"
  [ -z "$s" ] && s="unknown"
  printf '%s' "$s"
}

fmt_duration() {
  # 毫秒 -> m:ss
  local ms="${1:-0}" s
  s=$((ms / 1000))
  printf '%d:%02d' $((s / 60)) $((s % 60))
}

unique_path() {
  # $1=目录 $2=文件名(不含扩展) $3=扩展 -> 输出不冲突的完整路径
  local dir="$1" base="$2" ext="$3" p n=1
  p="$dir/$base.$ext"
  while [ -e "$p" ]; do
    n=$((n + 1)); p="$dir/$base ($n).$ext"
  done
  printf '%s' "$p"
}

# resolve_download_target <目录> <文件名(不含扩展)> <扩展>
# 结果写全局 RESOLVED_TARGET / CONFLICT_ACTION(new/overwrite/copy/skip)；
# 返回 3 表示用户选了跳过, 其余返回 0。
# 在解析成功、真正下载之前调用, 同名冲突不白白消耗下载流量。
# 无同名文件直接用原名；有同名且能打开 /dev/tty 时询问：
#   1) 覆盖  2) 创建副本 (默认, 回车即选)  3) 跳过这首
# 无 TTY (脚本/管道调用) 时无法询问, 默认创建副本 — 不覆盖是最安全的
# 默认值, 也与旧版「重名自动编号」行为一致。
RESOLVED_TARGET=""
CONFLICT_ACTION="new"
resolve_download_target() {
  local dir="$1" base="$2" ext="$3"
  local plain="$dir/$base.$ext"
  RESOLVED_TARGET="$plain"
  CONFLICT_ACTION="new"
  [ -e "$plain" ] || return 0

  local size_info=""
  size_info="$(ls -lh "$plain" 2>/dev/null | awk '{print $5}')"
  warn "  文件已存在: $plain${size_info:+ (大小 $size_info)}"
  if ! (: < /dev/tty) 2>/dev/null; then
    warn "  当前无法询问, 自动创建副本"
    CONFLICT_ACTION="copy"
    RESOLVED_TARGET="$(unique_path "$dir" "$base" "$ext")"
    return 0
  fi
  echo "  请选择: 1) 覆盖原文件  2) 创建副本 (默认)  3) 跳过这首"
  local choice=""
  while true; do
    if ! read -rp "  输入序号 [1/2/3]: " choice < /dev/tty; then
      # 读不到输入 (EOF) 时按默认走副本, 不无限重试
      choice=""
      CONFLICT_ACTION="copy"
      RESOLVED_TARGET="$(unique_path "$dir" "$base" "$ext")"
      info "  未收到选择, 自动创建副本: $(basename "$RESOLVED_TARGET")"
      return 0
    fi
    case "$choice" in
      1|o|O)
        CONFLICT_ACTION="overwrite"
        RESOLVED_TARGET="$plain"
        return 0 ;;
      ""|2|c|C)
        CONFLICT_ACTION="copy"
        RESOLVED_TARGET="$(unique_path "$dir" "$base" "$ext")"
        return 0 ;;
      3|s|S|q)
        CONFLICT_ACTION="skip"
        info "  已跳过: $(basename "$plain")"
        return 3 ;;
      *)
        warn "  无效选择, 请重新输入" ;;
    esac
  done
}

# remove_history_for_file <文件路径> : 从下载记录中删掉该路径的旧记录。
# 只在「覆盖」下载时调用: 旧文件内容已被新文件取代, 旧记录留着会让
# check-lyrics 对着新文件按旧元数据重复检测。副本下载走新路径, 不受影响。
remove_history_for_file() {
  local f="$1" tmp=""
  [ -f "$HISTORY_FILE" ] || return 0
  tmp="$(mktemp)" || return 0
  awk -F'\t' -v want="$f" '$1 ~ /^#/ || $7 != want' "$HISTORY_FILE" > "$tmp" \
    && mv -f "$tmp" "$HISTORY_FILE" || rm -f "$tmp"
  return 0
}

# 解析 "1 3 5-8" / "all" 为序号列表 (每行一个, 1-based), $1=输入 $2=上限
expand_selection() {
  local input="$1" max="$2" tok a b i
  input="$(tr ',' ' ' <<<"$input")"
  for tok in $input; do
    if [ "$tok" = "all" ]; then
      seq 1 "$max"; return 0
    elif [[ "$tok" =~ ^[0-9]+-[0-9]+$ ]]; then
      a="${tok%-*}"; b="${tok#*-}"
      [ "$a" -gt "$b" ] && { local t=$a; a=$b; b=$t; }
      [ "$a" -lt 1 ] && a=1; [ "$b" -gt "$max" ] && b=$max
      seq "$a" "$b"
    elif [[ "$tok" =~ ^[0-9]+$ ]]; then
      [ "$tok" -ge 1 ] && [ "$tok" -le "$max" ] && echo "$tok"
    fi
  done | sort -un
}

# ---------------- 核心: 单曲解析 + 下载 ----------------
# download_song <id> <name> <artists> <album> <picUrl>
# 返回: 0 成功, 1 失败, 2 API Key 无效, 3 用户跳过同名文件
download_song() {
  local id="$1" name="$2" artists="$3" album="$4" pic="$5"
  local lvl body url real_level size br
  local ext base target tmpfile ok_level=""

  info "解析: $artists - $name"
  while read -r lvl; do
    body="$(api_get 163_music "id=$id" "level=$lvl" "type=json" 2>/dev/null)"
    [ -z "$body" ] && continue
    if [ "$(api_code "$body")" = "401" ]; then
      err "API Key 无效, 停止下载"; return 2
    fi
    url="$(jq -r '.data.url // empty' <<<"$body" 2>/dev/null)"
    if [ -n "$url" ]; then
      ok_level="$lvl"
      real_level="$(jq -r '.data.level // empty' <<<"$body")"
      size="$(jq -r '.data.size // 0' <<<"$body")"
      br="$(jq -r '.data.br // 0' <<<"$body")"
      break
    fi
  done < <(fallback_levels)

  if [ -z "$ok_level" ]; then
    err "  全部音质解析失败 (可能版权限制/无可播放源)"
    return 1
  fi
  if [ "$real_level" != "$ok_level" ] && [ -n "$real_level" ]; then
    warn "  请求 $ok_level(${LEVEL_NAME[$ok_level]}), 实际返回 $real_level"
  else
    ok "  音质: $ok_level (${LEVEL_NAME[$ok_level]})"
  fi

  ext="${LEVEL_EXT[$ok_level]}"
  mkdir -p "$SAVE_DIR"
  base="$(sanitize "$artists - $name")"
  # 同名文件处理: 已存在时询问覆盖/副本/跳过 (详见 resolve_download_target)
  local is_overwrite=0
  if ! resolve_download_target "$SAVE_DIR" "$base" "$ext"; then
    return 3
  fi
  target="$RESOLVED_TARGET"
  [ "$CONFLICT_ACTION" = "overwrite" ] && is_overwrite=1
  tmpfile="$target.downloading"

  info "  下载 -> $(basename "$target")"
  if ! curl -fSL --retry 3 --retry-delay 2 -C - --progress-bar \
       -o "$tmpfile" "$url" --max-time 0; then
    warn "  断点续传失败, 尝试重新下载..."
    rm -f "$tmpfile"
    curl -fSL --retry 3 --retry-delay 2 --progress-bar \
      -o "$tmpfile" "$url" --max-time 0 || {
        err "  下载失败"; rm -f "$tmpfile"; return 1
      }
  fi
  mv -f "$tmpfile" "$target"
  ok "  已保存: $target"
  if [ "$is_overwrite" = 1 ]; then
    # 覆盖时清掉旧同名 .lrc: 下面歌词步骤会按新歌词重建,
    # 若新歌无歌词, 残留旧 .lrc 会被误认成本次下载的歌词。
    rm -f "${target%.*}.lrc"
  fi

  # 歌词: 落盘 .lrc + 提取纯文本用于嵌入文件
  local lrc_plain="" lrc_file="" lyric_status=""
  {
    local lrc_body lrc
    lrc_body="$(api_get 163_lyric "id=$id" 2>/dev/null)"
    lrc="$(jq -r '.data.lrc // empty' <<<"$lrc_body" 2>/dev/null)"
    if [ -n "$lrc" ] && [ "$lrc" != "null" ]; then
      if [ "$SAVE_LRC" = 1 ]; then
        printf '%s\n' "$lrc" > "${target%.*}.lrc"
        lrc_file="${target%.*}.lrc"
        ok "  歌词已保存"
      fi
      # 去时间轴, 留纯文本 (同 CDown 的 parse_lrc_to_uslt)
      lrc_plain="$(sed -e 's/^\[[^]]*\] *//' <<<"$lrc" | sed '/^[[:space:]]*$/d')"
    fi
  }

  # 元数据嵌入: 封面 + 标题/歌手/专辑 + 歌词 (播放器无需联网刮削)
  # lyric_status 语义: ok=已入标准帧, partial=仅 ffmpeg 回退(歌词未入标准帧),
  #   failed=嵌入失败/无工具, no-lyric=接口无歌词可嵌, skipped=嵌入开关已关
  if [ "$EMBED_META" = 1 ]; then
    EMBED_STATUS="failed"
    embed_metadata "$target" "$pic" "$lrc_plain" "$name" "$artists" "$album"
    if [ -z "$lrc_plain" ]; then
      lyric_status="no-lyric"
    else
      lyric_status="$EMBED_STATUS"
    fi
  else
    lyric_status="skipped"
  fi
  # 下载记录: 只记成功下载的文件, 供后续 check-lyrics 扫描。
  # 历史是日志, 不随后续修复改写; 当前嵌入状态以 check-lyrics 实测为准。
  # 例外: 覆盖下载先删该路径的旧记录再记新账 (理由见 remove_history_for_file)。
  if [ "$is_overwrite" = 1 ]; then
    remove_history_for_file "$target"
  fi
  record_download "$id" "$name" "$artists" "$album" "${real_level:-$ok_level}" \
    "$target" "$lrc_file" "$lyric_status"
  return 0
}

# embed_metadata <audio> <picUrl> <lyrics_plain> <title> <artist> <album>
# 优先 python3+mutagen (写入标准 USLT/LYRICS 歌词帧, 同原版 CDown),
# 回退 ffmpeg (封面+基础标签; 歌词只能进 TXXX, 部分播放器不识别)。
# 调用方读全局 EMBED_STATUS: ok/partial/failed/no-lyric (见 download_song 注释)。
# 返回值恒为 0, 嵌入失败不导致下载失败, 只记入下载记录。
EMBED_STATUS="failed"
embed_metadata() {
  local audio="$1" pic="$2" lyrics="$3" title="$4" artist="$5" album="$6"
  local ext="${audio##*.}" cover_tmp=""
  EMBED_STATUS="failed"
  if [ -n "$pic" ] && [ "$pic" != "null" ]; then
    cover_tmp="$(mktemp --suffix=.jpg)"
    curl -fsSL --max-time 20 -o "$cover_tmp" "$pic" 2>/dev/null || cover_tmp=""
  fi

  if command -v python3 >/dev/null 2>&1 && python3 -c "import mutagen" 2>/dev/null; then
    if python3 - "$audio" "$cover_tmp" "$lyrics" "$title" "$artist" "$album" <<'PYEOF' 2>/dev/null; then
import sys
audio, cover, lyrics, title, artist, album = sys.argv[1:7]
cover_data = None
if cover:
    with open(cover, 'rb') as f:
        cover_data = f.read()
if audio.lower().endswith('.mp3'):
    from mutagen.mp3 import MP3
    from mutagen.id3 import ID3, USLT, APIC, TIT2, TPE1, TALB
    a = MP3(audio, ID3=ID3)
    if a.tags is None:
        a.add_tags()
    t = a.tags
    for key in [k for k in list(t.keys()) if k.startswith('USLT') or k.startswith('APIC')]:
        del t[key]
    t.add(TIT2(encoding=3, text=title))
    t.add(TPE1(encoding=3, text=artist))
    t.add(TALB(encoding=3, text=album))
    if lyrics:
        t.add(USLT(encoding=3, lang='eng', desc='', text=lyrics))
    if cover_data:
        t.add(APIC(encoding=3, mime='image/jpeg', type=3, desc='', data=cover_data))
    a.save()
elif audio.lower().endswith('.flac'):
    from mutagen.flac import FLAC, Picture
    a = FLAC(audio)
    a['title'] = title
    a['artist'] = artist
    a['album'] = album
    if lyrics:
        a['lyrics'] = lyrics
    if cover_data:
        pic = Picture()
        pic.data = cover_data
        pic.mime = 'image/jpeg'
        pic.type = 3
        a.clear_pictures()
        a.add_picture(pic)
    a.save()
print('embed-ok')
PYEOF
      if [ -n "$lyrics" ]; then
        EMBED_STATUS="ok"
        ok "  元数据已嵌入 (封面/歌词/标签)"
      else
        EMBED_STATUS="no-lyric"
        ok "  元数据已嵌入 (封面/标签, 无歌词可嵌)"
      fi
      rm -f "$cover_tmp"
      return 0
    fi
    warn "  mutagen 嵌入失败, 尝试 ffmpeg"
  fi

  if [ -n "$cover_tmp" ]; then
    if command -v ffmpeg >/dev/null 2>&1; then
      local tagged="${audio}.tagged.${ext}"
      if ffmpeg -y -loglevel error -i "$audio" -i "$cover_tmp" \
           -map 0:a -map 1:v -c:a copy -c:v mjpeg \
           -disposition:v attached_pic \
           -metadata title="$title" -metadata artist="$artist" \
           -metadata album="$album" "$tagged" 2>/dev/null; then
        mv -f "$tagged" "$audio"
        EMBED_STATUS="partial"
        ok "  封面/标签已嵌入 (ffmpeg; 歌词未入标准帧, 建议安装 mutagen)"
      else
        rm -f "$tagged"
        EMBED_STATUS="failed"
        warn "  ffmpeg 嵌入失败"
      fi
    else
      EMBED_STATUS="failed"
      warn "  未安装 ffmpeg/mutagen, 跳过元数据嵌入 (菜单 5 可安装)"
    fi
  elif [ -z "$cover_tmp" ] && [ -n "$lyrics" ]; then
    EMBED_STATUS="failed"
    warn "  无封面且无嵌入工具, 跳过元数据嵌入"
  fi
  rm -f "$cover_tmp"
  return 0
}

# ---------------- 下载记录 + 歌词检测/修复 ----------------
# 记录格式 (TSV, 制表符分隔, 无 API Key):
#   时间  歌曲ID  歌名  歌手  专辑  实际音质  文件路径  .lrc路径  下载时歌词状态
# 下载时歌词状态: ok/partial/failed/no-lyric/skipped, 见 download_song。
# 检测以文件实测为准, 不读记录里的旧状态, 所以修复后无需改写历史。

escape_tsv() {
  local s="$1"
  s="${s//$'\t'/ }"
  s="${s//$'\n'/ }"
  s="${s//$'\r'/ }"
  printf '%s' "$s"
}

record_download() {
  local id="$1" title="$2" artist="$3" album="$4" level="$5"
  local file="$6" lrc="$7" status="$8"
  # 空字段用 - 占位: TSV 空字段在 bash read 里会被吞掉导致错位,
  # 专辑、.lrc 都可能为空 (如 do_song 不传专辑、SAVE_LRC=0 时无 .lrc)。
  [ -z "$title" ] && title="-"
  [ -z "$artist" ] && artist="-"
  [ -z "$album" ] && album="-"
  [ -z "$level" ] && level="-"
  [ -z "$lrc" ] && lrc="-"
  [ -z "$status" ] && status="-"
  mkdir -p "$CONFIG_DIR" 2>/dev/null || return 0
  if [ ! -f "$HISTORY_FILE" ]; then
    printf '#time\tid\ttitle\tartist\talbum\tlevel\tfile\tlrc\tlyric_status\n' > "$HISTORY_FILE"
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" \
    "$(escape_tsv "$id")" "$(escape_tsv "$title")" "$(escape_tsv "$artist")" \
    "$(escape_tsv "$album")" "$(escape_tsv "$level")" "$(escape_tsv "$file")" \
    "$(escape_tsv "$lrc")" "$(escape_tsv "$status")" >> "$HISTORY_FILE"
}

history_id_for_file() {
  local f="$1"
  [ -f "$HISTORY_FILE" ] || return 1
  awk -F'\t' -v want="$f" '$1 !~ /^#/ && $7 == want {print $2; exit}' "$HISTORY_FILE"
}

show_history() {
  local arg="${1:-}" total=0
  if [ ! -f "$HISTORY_FILE" ]; then
    warn "暂无下载记录 (成功下载后自动记录)"
    return 0
  fi
  total="$(grep -vc '^#' "$HISTORY_FILE" 2>/dev/null)"
  [ -z "$total" ] && total=0
  if [ "$total" = "0" ]; then
    warn "暂无下载记录 (成功下载后自动记录)"
    return 0
  fi
  local limit=50
  if [ "$arg" = "all" ]; then
    limit="$total"
  elif [[ "$arg" =~ ^[0-9]+$ ]]; then
    limit="$arg"
  fi
  hr
  printf "下载记录: 共 %s 条 (显示最近 %s 条)\n" "$total" "$limit"
  hr
  # 用 \x1f 作分隔符再读: \t 是 IFS 空白字符, read 会吞掉空字段导致错位;
  # \x1f 是非空白分隔符, 空字段能原样保留 (见 record_download 的 - 占位说明)。
  awk -F'\t' '!/^#/ {print $1 "\x1f" $2 "\x1f" $3 "\x1f" $4 "\x1f" $5 "\x1f" $6 "\x1f" $7 "\x1f" $8 "\x1f" $9}' \
    "$HISTORY_FILE" | tail -n "$limit" | while IFS=$'\x1f' read -r ts sid title artist album level file lrc status; do
    printf '%s | %s - %s | %s | 下载时歌词: %s\n  -> %s\n' \
      "$ts" "$artist" "$title" "$level" "$status" "$file"
  done
  if [ "$total" -gt "$limit" ]; then
    info "查看全部: chksz history all"
  fi
}

lyric_status_label() {
  case "$1" in
    ok) echo "已嵌入标准歌词帧" ;;
    missing) echo "未嵌入歌词" ;;
    partial) echo "仅有非标准歌词帧 (部分播放器不识别)" ;;
    missing-file) echo "文件已不存在" ;;
    unsupported) echo "不支持的文件格式 (仅 MP3/FLAC)" ;;
    no-tool) echo "无法检测 (缺 python3+mutagen)" ;;
    error) echo "检测出错" ;;
    *) echo "$1" ;;
  esac
}

# lyric_check_status <文件> -> ok/missing/partial/missing-file/unsupported/no-tool/error
# 判定标准: MP3 看标准 USLT 帧 (非空才算), FLAC 看 LYRICS 字段。
# 旧版 ffmpeg 遗留的 TXXX 歌词不算成功, 只算 partial, 修复时会换成 USLT。
lyric_check_status() {
  local f="$1"
  [ -f "$f" ] || { echo "missing-file"; return 0; }
  if ! command -v python3 >/dev/null 2>&1 || ! python3 -c "import mutagen" 2>/dev/null; then
    echo "no-tool"; return 0
  fi
  python3 - "$f" <<'PYEOF' 2>/dev/null || echo "error"
import sys

def txt(v):
    if v is None:
        return ""
    if isinstance(v, (list, tuple)):
        return " ".join(str(x) for x in v).strip()
    return str(v).strip()

path = sys.argv[1]
try:
    low = path.lower()
    if low.endswith('.mp3'):
        from mutagen.id3 import ID3
        try:
            tags = ID3(path)
        except Exception:
            print('missing'); sys.exit(0)
        for fr in tags.getall('USLT'):
            if txt(fr.text):
                print('ok'); sys.exit(0)
        for fr in tags.getall('TXXX'):
            desc = (getattr(fr, 'desc', '') or '').lower()
            if 'lyric' in desc or 'uslt' in desc:
                if txt(fr.text):
                    print('partial'); sys.exit(0)
        print('missing')
    elif low.endswith('.flac'):
        from mutagen.flac import FLAC
        try:
            a = FLAC(path)
        except Exception:
            print('missing'); sys.exit(0)
        vals = a.get('lyrics', [])
        if any(txt(v) for v in vals):
            print('ok')
        else:
            print('missing')
    else:
        print('unsupported')
except Exception:
    print('error')
PYEOF
}

# lrc_to_plain <lrc文件> : 去时间轴、去 [ti:]/[ar:] 等纯元数据行, 输出纯文本歌词
lrc_to_plain() {
  local f="$1"
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$f" <<'PYEOF' 2>/dev/null
import sys, re
path = sys.argv[1]
ts_re = re.compile(r'^\[\d+:\d+(?:\.\d+)?\]')
meta_re = re.compile(r'^\[[A-Za-z]+:[^\]]*\]$')
with open(path, encoding='utf-8', errors='ignore') as fh:
    for line in fh:
        s = line.strip()
        if not s or meta_re.match(s):
            continue
        while ts_re.match(s):
            s = ts_re.sub('', s, count=1).strip()
        if s:
            print(s)
PYEOF
  else
    sed -E 's/^(\[[^]]*\])+//; s/^[[:space:]]+//' "$f" | sed '/^[[:space:]]*$/d'
  fi
}

# embed_lyrics_only <音频> <纯文本歌词文件>
# 只动歌词: MP3 删旧 USLT/歌词类 TXXX 后加 USLT, FLAC 只写 LYRICS。
# 封面、标题/歌手/专辑等其他标签原样保留。返回: 0 成功, 2 歌词为空, 3 不支持格式。
embed_lyrics_only() {
  local audio="$1" plain="$2"
  [ -f "$audio" ] && [ -f "$plain" ] || return 1
  python3 - "$audio" "$plain" <<'PYEOF' 2>/dev/null
import sys
audio, plain_path = sys.argv[1:3]
with open(plain_path, encoding='utf-8', errors='ignore') as fh:
    lyrics = fh.read().strip()
if not lyrics:
    sys.exit(2)
low = audio.lower()
if low.endswith('.mp3'):
    from mutagen.mp3 import MP3
    from mutagen.id3 import ID3, USLT
    a = MP3(audio, ID3=ID3)
    if a.tags is None:
        a.add_tags()
    t = a.tags
    for key in [k for k in list(t.keys()) if k.startswith('USLT')]:
        del t[key]
    for key in [k for k in list(t.keys()) if k.startswith('TXXX')]:
        desc = (getattr(t[key], 'desc', '') or '').lower()
        if 'lyric' in desc or 'uslt' in desc:
            del t[key]
    t.add(USLT(encoding=3, lang='eng', desc='', text=lyrics))
    a.save()
elif low.endswith('.flac'):
    from mutagen.flac import FLAC
    a = FLAC(audio)
    a['lyrics'] = lyrics
    a.save()
else:
    sys.exit(3)
print('fix-ok')
PYEOF
}

# fix_one_file <文件> [歌曲ID]
# 歌词来源优先级: 1) 同名 .lrc (离线, 最可靠)  2) 下载记录/--id 查到的 ID 走 API 拿歌词
# 结果写入全局 FIX_RESULT: ok/already-ok/no-lyric/no-source/no-apikey/
#   missing-file/unsupported/no-tool/failed
FIX_RESULT="failed"
fix_one_file() {
  local f="$1" sid="${2:-}"
  FIX_RESULT="failed"
  local st
  st="$(lyric_check_status "$f")"
  case "$st" in
    ok)
      ok "  已有标准歌词帧, 无需修复: $f"
      FIX_RESULT="already-ok"; return 0 ;;
    missing-file)
      err "  文件已不存在: $f"
      FIX_RESULT="missing-file"; return 1 ;;
    no-tool)
      err "  检测/修复需 python3+mutagen, 先运行: chksz deps"
      FIX_RESULT="no-tool"; return 1 ;;
    unsupported)
      warn "  不支持的文件格式 (仅 MP3/FLAC): $f"
      FIX_RESULT="unsupported"; return 1 ;;
    error)
      err "  检测出错, 跳过: $f"
      FIX_RESULT="error"; return 1 ;;
  esac
  # 此时 st 为 missing 或 partial, 需要歌词来源
  [ -z "$sid" ] && sid="$(history_id_for_file "$f")"
  local src_tmp plain_tmp lrc_src=""
  src_tmp="$(mktemp)"; plain_tmp="$(mktemp)"
  if [ -f "${f%.*}.lrc" ]; then
    lrc_src="${f%.*}.lrc"
    cp "$lrc_src" "$src_tmp"
    info "  歌词来源: 同名 .lrc"
  elif [ -n "$sid" ]; then
    require_apikey || { rm -f "$src_tmp" "$plain_tmp"; FIX_RESULT="no-apikey"; return 1; }
    local body lrc code
    body="$(api_get 163_lyric "id=$sid" 2>/dev/null)"
    code="$(api_code "$body")"
    if [ "$code" = "401" ]; then
      rm -f "$src_tmp" "$plain_tmp"
      err "  API Key 无效 (401), 无法从接口取歌词"
      FIX_RESULT="no-apikey"; return 1
    fi
    lrc="$(jq -r '.data.lrc // empty' <<<"$body" 2>/dev/null)"
    if [ -z "$lrc" ] || [ "$lrc" = "null" ]; then
      rm -f "$src_tmp" "$plain_tmp"
      warn "  接口无歌词, 无法修复 (可能为纯音乐/无歌词歌曲): $f"
      FIX_RESULT="no-lyric"; return 0
    fi
    printf '%s\n' "$lrc" > "$src_tmp"
    info "  歌词来源: API (歌曲 ID $sid)"
    if [ "$SAVE_LRC" = 1 ] && [ ! -f "${f%.*}.lrc" ]; then
      cp "$src_tmp" "${f%.*}.lrc"
      info "  歌词已补存为同名 .lrc"
    fi
  else
    rm -f "$src_tmp" "$plain_tmp"
    warn "  无同名 .lrc, 且下载记录中找不到歌曲 ID, 无法获取歌词: $f"
    warn "  可手动放同名 .lrc 后再修, 或用: chksz fix-lyrics \"$f\" --id <歌曲ID>"
    FIX_RESULT="no-source"; return 1
  fi
  lrc_to_plain "$src_tmp" > "$plain_tmp"
  if [ ! -s "$plain_tmp" ]; then
    rm -f "$src_tmp" "$plain_tmp"
    warn "  歌词内容为空, 无法修复 (可能为纯音乐/无歌词歌曲): $f"
    FIX_RESULT="no-lyric"; return 0
  fi
  local rc=0
  embed_lyrics_only "$f" "$plain_tmp" >/dev/null; rc=$?
  rm -f "$src_tmp" "$plain_tmp"
  if [ "$rc" = "2" ]; then
    warn "  歌词内容为空, 无法修复: $f"
    FIX_RESULT="no-lyric"; return 0
  fi
  if [ "$rc" != "0" ]; then
    err "  歌词嵌入失败: $f"
    FIX_RESULT="failed"; return 1
  fi
  if [ "$(lyric_check_status "$f")" = "ok" ]; then
    ok "  已修复: $f"
    FIX_RESULT="ok"; return 0
  fi
  warn "  嵌入后复测仍未通过: $f"
  FIX_RESULT="failed"; return 1
}

# check_lyrics_cmd [--fix] [文件]
# 无文件参数时扫描全部下载记录; 有文件参数时只检测该文件。
# 不带 --fix 且发现缺失时, 有 TTY 就询问是否修复, 无 TTY 只提示命令。
check_lyrics_cmd() {
  local do_fix=0 target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --fix) do_fix=1 ;;
      -*) err "未知选项: $1 (用法: chksz check-lyrics [--fix] [文件])"; return 1 ;;
      *) target="$1" ;;
    esac
    shift
  done

  if [ -n "$target" ]; then
    local st
    st="$(lyric_check_status "$target")"
    printf '%s: %s\n' "$target" "$(lyric_status_label "$st")"
    if [ "$st" = "missing" ] || [ "$st" = "partial" ]; then
      if [ "$do_fix" = "0" ]; then
        local yn=""
        if [ -t 0 ]; then
          read -rp "是否修复这首? [y/N]: " yn
        fi
        [[ "$yn" =~ ^[yY]$ ]] && do_fix=1
      fi
      [ "$do_fix" = "1" ] && fix_one_file "$target" ""
    fi
    return 0
  fi

  if ! command -v python3 >/dev/null 2>&1 || ! python3 -c "import mutagen" 2>/dev/null; then
    err "检测需 python3+mutagen, 先运行: chksz deps"
    return 1
  fi
  if [ ! -f "$HISTORY_FILE" ]; then
    warn "暂无下载记录, 先下载歌曲或用 chksz check-lyrics <文件> 检测单个文件"
    return 0
  fi
  local total=0 okc=0 missc=0 partialc=0 missfile=0 unsup=0 errc=0
  local -a fix_files=() fix_ids=()
  while IFS=$'\x1f' read -r ts sid title artist album level file lrc status; do
    total=$((total + 1))
    if [ ! -f "$file" ]; then
      missfile=$((missfile + 1))
      printf '[文件已不存在] %s - %s\n  -> %s\n' "$artist" "$title" "$file"
      continue
    fi
    local st
    st="$(lyric_check_status "$file")"
    case "$st" in
      ok) okc=$((okc + 1)); printf '[已嵌入] %s - %s\n' "$artist" "$title" ;;
      missing)
        missc=$((missc + 1)); fix_files+=("$file"); fix_ids+=("$sid")
        printf '[未嵌入] %s - %s\n  -> %s\n' "$artist" "$title" "$file" ;;
      partial)
        partialc=$((partialc + 1)); fix_files+=("$file"); fix_ids+=("$sid")
        printf '[非标准帧] %s - %s\n  -> %s\n' "$artist" "$title" "$file" ;;
      unsupported)
        unsup=$((unsup + 1)); printf '[不支持格式] %s - %s\n  -> %s\n' "$artist" "$title" "$file" ;;
      *) errc=$((errc + 1)); printf '[检测出错] %s - %s\n  -> %s\n' "$artist" "$title" "$file" ;;
    esac
  done < <(awk -F'\t' '!/^#/ {print $1 "\x1f" $2 "\x1f" $3 "\x1f" $4 "\x1f" $5 "\x1f" $6 "\x1f" $7 "\x1f" $8 "\x1f" $9}' "$HISTORY_FILE")
  hr
  printf '检测完成: 共 %s 条记录, 已嵌入 %s, 未嵌入 %s, 非标准帧 %s, 文件已不存在 %s, 不支持格式 %s, 出错 %s\n' \
    "$total" "$okc" "$missc" "$partialc" "$missfile" "$unsup" "$errc"
  local fixable=$((missc + partialc))
  if [ "$fixable" = "0" ]; then
    ok "无需修复"
    return 0
  fi
  if [ "$do_fix" = "0" ]; then
    # 只在 stdin 是终端时询问, 非交互运行不碰 /dev/tty (无控制终端时会报
    # "/dev/tty: No such device"), 直接提示 --fix 命令。
    local yn=""
    if [ -t 0 ]; then
      read -rp "是否修复以上 $fixable 首? [y/N]: " yn
    fi
    [[ "$yn" =~ ^[yY]$ ]] || { info "未修复, 需要时执行: chksz check-lyrics --fix"; return 0; }
    do_fix=1
  fi
  local fixed=0 failed=0 nolyric=0 i
  for ((i = 0; i < ${#fix_files[@]}; i++)); do
    printf '%s - %s\n' "" ""
    info "修复: ${fix_files[$i]}"
    if fix_one_file "${fix_files[$i]}" "${fix_ids[$i]}"; then
      fixed=$((fixed + 1))
    elif [ "$FIX_RESULT" = "no-lyric" ]; then
      nolyric=$((nolyric + 1))
    else
      failed=$((failed + 1))
    fi
  done
  hr
  printf '修复完成: 成功 %s, 无歌词可修 %s, 失败 %s\n' "$fixed" "$nolyric" "$failed"
}

# fix_lyrics_cmd <文件> [--id ID] | fix_lyrics_cmd --all
fix_lyrics_cmd() {
  local do_all=0 sid="" target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) do_all=1 ;;
      --id) shift; sid="${1:-}" ;;
      --id=*) sid="${1#--id=}" ;;
      -*) err "未知选项: $1"; return 1 ;;
      *) target="$1" ;;
    esac
    shift
  done
  if [ "$do_all" = "1" ]; then
    check_lyrics_cmd --fix
    return $?
  fi
  if [ -z "$target" ]; then
    err "用法: chksz fix-lyrics <文件> [--id <歌曲ID>] 或 chksz fix-lyrics --all"
    return 1
  fi
  fix_one_file "$target" "$sid"
}

# ---------------- 搜索下载 ----------------
do_search() {
  local kw="$1" body code count i
  require_apikey || return 1
  if [ -z "$kw" ]; then
    read -rp "搜索关键词: " kw < /dev/tty
  fi
  [ -z "$kw" ] && { err "关键词为空"; return 1; }

  info "搜索: $kw ..."
  body="$(api_get 163_search "keyword=$kw" "limit=20" "offset=0")"
  [ -z "$body" ] && { err "搜索接口无响应, 稍后重试"; return 1; }
  check_api_resp "$body" "搜索" || return 1

  count="$(jq '.data.songs | length' <<<"$body")"
  [ "$count" = "0" ] && { warn "没有搜到结果"; return 1; }

  hr
  printf "%-4s %-40s %s\n" "序号" "歌曲" "时长"
  hr
  for ((i = 0; i < count; i++)); do
    local nm ar al du
    nm="$(jq -r ".data.songs[$i].name" <<<"$body")"
    ar="$(jq -r ".data.songs[$i].artists" <<<"$body")"
    al="$(jq -r ".data.songs[$i].album" <<<"$body")"
    du="$(jq -r ".data.songs[$i].duration" <<<"$body")"
    printf "%-4d %-40.40s %s - %s [%s]\n" \
      $((i + 1)) "$nm" "$ar" "$al" "$(fmt_duration "$du")"
  done
  hr

  local sel ids n=0
  read -rp "输入序号下载 (如 1 3 5-8, all=全部, q=返回): " sel < /dev/tty
  [ "$sel" = "q" ] && return 0
  mapfile -t ids < <(expand_selection "$sel" "$count")
  [ ${#ids[@]} = "0" ] && { warn "未选择有效序号"; return 1; }

  local idx sid nm ar al pic okc=0 failc=0 skipc=0 drc=0
  for idx in "${ids[@]}"; do
    i=$((idx - 1))
    sid="$(jq -r ".data.songs[$i].id" <<<"$body")"
    nm="$(jq -r ".data.songs[$i].name" <<<"$body")"
    ar="$(jq -r ".data.songs[$i].artists" <<<"$body")"
    al="$(jq -r ".data.songs[$i].album" <<<"$body")"
    pic="$(jq -r ".data.songs[$i].picUrl // empty" <<<"$body")"
    download_song "$sid" "$nm" "$ar" "$al" "$pic"; drc=$?
    case "$drc" in
      0) okc=$((okc + 1)) ;;
      3) skipc=$((skipc + 1)) ;;
      *) failc=$((failc + 1)) ;;
    esac
    n=$((n + 1))
    echo
  done
  ok "完成: 成功 $okc 首, 失败 $failc 首, 跳过 $skipc 首"
}

# ---------------- 歌单解析下载 ----------------
extract_playlist_id() {
  local in="$1"
  if [[ "$in" =~ ^[0-9]+$ ]]; then
    echo "$in"
  elif [[ "$in" =~ [\?\&]id=([0-9]+) ]]; then
    echo "${BASH_REMATCH[1]}"
  else
    grep -oE '[0-9]{4,}' <<<"$in" | head -1
  fi
}

do_playlist() {
  local raw="$1" pid body code name creator tcount i
  require_apikey || return 1
  if [ -z "$raw" ]; then
    read -rp "歌单 ID 或链接: " raw < /dev/tty
  fi
  pid="$(extract_playlist_id "$raw")"
  [ -z "$pid" ] && { err "无法识别歌单 ID"; return 1; }

  info "解析歌单 $pid ..."
  body="$(api_get 163_playlist "id=$pid")"
  [ -z "$body" ] && { err "歌单接口无响应, 稍后重试"; return 1; }
  check_api_resp "$body" "歌单解析" || return 1

  name="$(jq -r '.data.name // "未知歌单"' <<<"$body")"
  creator="$(jq -r '.data.creator.nickname // ""' <<<"$body")"
  tcount="$(jq '.data.tracks | length' <<<"$body")"
  [ "$tcount" = "0" ] && { warn "歌单为空"; return 1; }

  hr
  printf "歌单: %s\n创建者: %s\n歌曲数: %s\n" "$name" "$creator" "$tcount"
  hr
  local show=$((tcount < 15 ? tcount : 15))
  for ((i = 0; i < show; i++)); do
    local nm ar
    nm="$(jq -r ".data.tracks[$i].name" <<<"$body")"
    ar="$(jq -r '[.data.tracks['$i'].ar[].name] | join("/")' <<<"$body")"
    printf "%-4d %s - %s\n" $((i + 1)) "$nm" "$ar"
  done
  [ "$tcount" -gt "$show" ] && echo "... 等共 $tcount 首"
  hr

  local sel
  read -rp "下载全部(all)/输入序号(如 1 3 5-8)/q返回: " sel < /dev/tty
  [ "$sel" = "q" ] && return 0
  [ -z "$sel" ] && sel="all"

  local idx sid nm ar al pic okc=0 failc=0 skipc=0 n=0 drc=0
  while read -r idx; do
    i=$((idx - 1))
    sid="$(jq -r ".data.tracks[$i].id" <<<"$body")"
    nm="$(jq -r ".data.tracks[$i].name" <<<"$body")"
    ar="$(jq -r '[.data.tracks['$i'].ar[].name] | join("/")' <<<"$body")"
    al="$(jq -r ".data.tracks[$i].al.name // empty" <<<"$body")"
    pic="$(jq -r ".data.tracks[$i].al.picUrl // empty" <<<"$body")"
    printf "${C_BOLD}[$((n+1))]%s${C_RESET}\n" ""
    download_song "$sid" "$nm" "$ar" "$al" "$pic"; drc=$?
    case "$drc" in
      0) okc=$((okc + 1)) ;;
      3) skipc=$((skipc + 1)) ;;
      *) failc=$((failc + 1)) ;;
    esac
    n=$((n + 1)); echo
  done < <(expand_selection "$sel" "$tcount")
  ok "歌单下载完成: 成功 $okc 首, 失败 $failc 首, 跳过 $skipc 首"
}

# ---------------- 单曲 ID 直接下载 ----------------
do_song() {
  local sid="$1" body nm ar al pic
  require_apikey || return 1
  [ -z "$sid" ] && read -rp "歌曲 ID: " sid < /dev/tty
  [[ "$sid" =~ ^[0-9]+$ ]] || { err "歌曲 ID 应为数字"; return 1; }

  # 先用 lyric 接口顺手拿到歌曲名/歌手信息做文件名 (失败则用 ID)
  body="$(api_get 163_lyric "id=$sid" 2>/dev/null)"
  nm=""; ar=""; al=""; pic=""
  local drc=0
  download_song "$sid" "${nm:-$sid}" "${ar:-unknown}" "$al" "$pic"; drc=$?
  # 用户主动跳过同名文件不算失败, 正常返回 0
  if [ "$drc" = 3 ]; then
    info "已跳过同名文件, 未下载"
    return 0
  fi
  return "$drc"
}

# ---------------- 设置 ----------------
set_apikey() {
  local k="$1" body
  if [ -z "$k" ]; then
    echo "获取地址: https://api.chksz.com (登录后查看个人密钥)"
    read -rsp "请输入 API Key: " k < /dev/tty; echo
  fi
  [ -z "$k" ] && { err "Key 为空, 未保存"; return 1; }
  APIKEY="$k"
  info "校验 Key 有效性..."
  body="$(api_get 163_lyric "id=0" 2>/dev/null)"
  if [ "$(api_code "$body")" = "401" ]; then
    err "Key 无效 (401), 未保存"
    APIKEY=""; return 1
  fi
  save_config
  ok "API Key 已保存并通过校验"
}

set_savedir() {
  local d="$1"
  [ -z "$d" ] && read -rp "下载目录 (当前: $SAVE_DIR): " d < /dev/tty
  [ -z "$d" ] && return 0
  # 支持 ~ 展开
  d="${d/#\~/$HOME}"
  mkdir -p "$d" || { err "目录创建失败"; return 1; }
  SAVE_DIR="$(readlink -f "$d")"
  save_config
}

set_quality() {
  local q="$1" i=1
  if [ -z "$q" ]; then
    echo "选择首选音质 (解析失败时自动向下回退):"
    local l
    for l in "${LEVELS[@]}"; do
      printf "  %d) %s (%s)%s\n" "$i" "$l" "${LEVEL_NAME[$l]}" \
        "$([ "$l" = "$QUALITY" ] && echo "  <-- 当前")"
      i=$((i + 1))
    done
    read -rp "请输入序号: " q < /dev/tty
    [[ "$q" =~ ^[1-5]$ ]] || { warn "取消"; return 0; }
    q="${LEVELS[$((q - 1))]}"
  fi
  local valid=0 l
  for l in "${LEVELS[@]}"; do [ "$l" = "$q" ] && valid=1; done
  [ "$valid" = 1 ] || { err "未知音质: $q"; return 1; }
  QUALITY="$q"
  save_config
  ok "首选音质: $q (${LEVEL_NAME[$q]}), 回退顺序: $(fallback_levels | tr '\n' ' ')"
}

settings_menu() {
