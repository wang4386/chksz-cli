  printf "${C_BOLD}${C_CYAN}"
  cat <<'EOF'
   ____ _     _  __ ____ _____
  / ___| |__ | |/ // ___|__  /
 | |   | '_ \| ' / \___ \ / /
 | |___| | | | . \  ___) / /_
  \____|_| |_|_|\_\|____/____|
EOF
  printf "${C_RESET}"
  echo "  ChKSz API 交互式音乐下载 v$VERSION (网易云)"
}

main_menu() {
  local c
  while true; do
    clear 2>/dev/null || true
    banner
    show_config
    echo "1) 搜索歌曲下载"
    echo "2) 歌单解析下载"
    echo "3) 单曲 ID 直接下载"
    echo "4) 设置 (Key/目录/音质)"
    echo "5) 安装依赖"
    echo "6) 安装 chksz 快捷命令"
    echo "7) 卸载 chksz"
    echo "0) 退出"
    read -rp "请选择: " c < /dev/tty
    case "$c" in
      1) do_search "" ;;
      2) do_playlist "" ;;
      3) do_song "" ;;
      4) settings_menu ;;
      5) install_deps ;;
      6) install_shortcut ;;
      7) uninstall ;;
      0) echo "再见!"; exit 0 ;;
      *) warn "无效选择" ;;
    esac
    echo; pause
  done
}

usage() {
  cat <<EOF
chksz v$VERSION - ChKSz API 交互式音乐下载 (网易云)

用法:
  chksz                          进入交互菜单
  chksz search "关键词"           搜索歌曲并选择下载
  chksz playlist <ID或链接>      解析歌单并批量下载
  chksz song <歌曲ID>            直接下载单曲
  chksz key [apikey]             设置/更新 API Key (持久化保存)
  chksz dir [下载目录]            设置下载位置
  chksz quality [音质]           设置首选音质: jymaster|hires|lossless|exhigh|standard
  chksz deps                     安装依赖 (curl/jq/ffmpeg)
  chksz install                  安装 chksz 快捷命令到 ~/.local/bin
  chksz uninstall                安全卸载 (删脚本/配置/快捷命令, 逐项确认)
  chksz config                   查看当前配置
  chksz help                     显示本帮助

配置保存在: $CONFIG_FILE
API Key 获取: https://api.chksz.com (登录后查看个人密钥)
EOF
}

# ---------------- 入口 ----------------
main() {
  load_config
  local cmd="${1:-}"
  case "$cmd" in
    ""|menu)        main_menu ;;
    search)         shift; do_search "${1:-}" ;;
    playlist|pl)    shift; do_playlist "${1:-}" ;;
    song|dl)        shift; do_song "${1:-}" ;;
    key)            shift; set_apikey "${1:-}" ;;
    dir)            shift; set_savedir "${1:-}" ;;
    quality|q)      shift; set_quality "${1:-}" ;;
    deps)           install_deps ;;
    install)        install_shortcut ;;
    uninstall)      uninstall ;;
    config)         show_config ;;
    help|--help|-h) usage ;;
    version|--version|-v) echo "chksz v$VERSION" ;;
    *) err "未知命令: $cmd"; usage; exit 1 ;;
  esac
}

main "$@"
